# Скопируйте в .env и заполните: cp .env.example .env

# --- Обязательные ---

# Токен бота от @BotFather.
TG_TOKEN=123456789:AAAA-замените-на-свой-токен

# Администраторы бота: Telegram user id через запятую или пробел.
# Свой id можно узнать у @userinfobot.
TG_ALLOWED=111111111

# --- Необязательные ---

# Обычные пользователи без прав администратора (id через запятую или пробел).
TG_USERS=

# Группы с темами, подключённые заранее (id групп, обычно начинаются с -100).
# Можно не задавать: группа подключается командой /start от разрешённого пользователя.
TG_GROUPS=

# Движок по умолчанию: claude или codex.
CLAUDE_TG_ENGINE=claude

# Модель claude по умолчанию: opus, sonnet или haiku.
CLAUDE_TG_MODEL=sonnet

# Модель распознавания голосовых (faster-whisper): tiny, base, small, medium, large-v3.
# Чем больше, тем точнее, но медленнее и тяжелее по памяти. Скачивается при первом голосовом.
CLAUDE_TG_STT_MODEL=small

# Язык голосовых (ru, en, ...). Пусто — определяется автоматически.
CLAUDE_TG_STT_LANG=
